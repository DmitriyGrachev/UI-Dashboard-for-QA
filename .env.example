# HTTP port exposed on the host.
SERVER_PORT=8080

# Host directory containing production screenshots.
# Windows example: C:/recognition/screenshots
VALIDATOR_IMAGE_ROOT_HOST=./data/images

# Set to false to hide the matching screenshot counter and skip its COUNT queries.
COUNT_REMAINING_SCREENSHOTS=true

# Host directory containing persistent PostgreSQL files.
# Keep it on a local disk outside OneDrive and other synchronized folders.
POSTGRES_DATA_ROOT_HOST=./data/postgres

# Main PostgreSQL database used by the application.
DB_NAME=recognition_validator
DB_USERNAME=validator
DB_PASSWORD=validator

# Safe defaults for this MVP. Increase only after observing server metrics.
DB_MAX_POOL_SIZE=10
POSTGRES_MAX_CONNECTIONS=50

# Shared memory for PostgreSQL parallel queries under concurrent operator load.
POSTGRES_SHM_SIZE=256mb

# Concurrent operators already parallelize the workload; avoid per-query workers.
POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=0
