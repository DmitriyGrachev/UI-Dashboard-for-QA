# -----------------------------------------------------------------------------
# Host and application
# -----------------------------------------------------------------------------

# HTTP port exposed only on 127.0.0.1 of the Docker host.
SERVER_PORT=18080

# Host directory containing screenshots.
# Linux example: /opt/dataox/dmytro-test/images-source
# Windows example: C:/recognition/screenshots
VALIDATOR_IMAGE_ROOT_HOST=./data/images

# Set to false to hide the matching screenshot counter and skip its COUNT queries.
COUNT_REMAINING_SCREENSHOTS=true

# -----------------------------------------------------------------------------
# Persistent PostgreSQL storage and credentials
# -----------------------------------------------------------------------------

# Host directory containing persistent PostgreSQL files.
# Keep it on a local disk outside OneDrive and other synchronized folders.
# Linux example: /opt/dataox/dmytro-test/recognition-validator-postgres-data
# Windows example: C:/recognition-validator-data/postgres
POSTGRES_DATA_ROOT_HOST=./data/postgres

DB_NAME=recognition_validator
DB_USERNAME=validator

# Replace before the first start. Changing it later does not update an existing DB.
DB_PASSWORD=change-me-before-start

# -----------------------------------------------------------------------------
# Application database pool
# -----------------------------------------------------------------------------

# Safe defaults for the expected small number of concurrent operators.
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# -----------------------------------------------------------------------------
# PostgreSQL process
# -----------------------------------------------------------------------------

POSTGRES_MAX_CONNECTIONS=50

# Shared memory available to PostgreSQL inside the container.
POSTGRES_SHM_SIZE=256mb

# Operators already parallelize the workload; avoid extra workers per query.
POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=0

# -----------------------------------------------------------------------------
# Image indexing
# -----------------------------------------------------------------------------

# Maximum number of image metadata rows written in one database batch.
VALIDATOR_BATCH_SIZE=1000

# -----------------------------------------------------------------------------
# Review queue
# -----------------------------------------------------------------------------

# How long a claimed screenshot remains assigned when the operator disappears.
# Spring duration examples: 30m, 2h, 45s.
VALIDATOR_LEASE_DURATION=30m

# -----------------------------------------------------------------------------
# Database retention cleanup
# -----------------------------------------------------------------------------

# Retain image metadata and completed tasks for this long.
VALIDATOR_RETENTION=7d

# Maximum rows deleted per cleanup transaction and batches per cleanup run.
VALIDATOR_CLEANUP_BATCH_SIZE=5000
VALIDATOR_CLEANUP_MAX_BATCHES=20

# -----------------------------------------------------------------------------
# Filesystem watcher
# -----------------------------------------------------------------------------

# Disable only for diagnostics; without it new files require reconciliation/restart.
VALIDATOR_WATCH_ENABLED=true

# Coalesce filesystem events and write them to the database at this interval.
VALIDATOR_WATCH_FLUSH_INTERVAL=2s

# Application-side event buffer. Overflow triggers a full reconciliation scan.
VALIDATOR_WATCH_MAX_PENDING_EVENTS=50000
