# -----------------------------------------------------------------------------
# Host and application
# -----------------------------------------------------------------------------

# HTTP port exposed by the application container on the Docker host.
SERVER_PORT=18080

# PostgreSQL port exposed on the Docker host. Containers still use port 5432.
POSTGRES_HOST_PORT=5436

# Hard Docker limit for the application container. Includes JVM heap and native memory.
APP_MEMORY_LIMIT=5g

# Optional CPU quota for the entire app (UI, indexer, JVM and B2), not for its build.
# 0.0 = unchanged/unlimited. Set 2.0 only after agreeing on the production quota.
APP_CPU_LIMIT=0.0

# Host directory containing screenshots.
# Linux example: /data/recognition-api/completed_recognition
# Windows example: C:/recognition/screenshots
VALIDATOR_IMAGE_ROOT_HOST=./data/images

# Set to false to hide the matching screenshot counter and skip its COUNT queries.
COUNT_REMAINING_SCREENSHOTS=true

# -----------------------------------------------------------------------------
# Read-only image API for another service
# -----------------------------------------------------------------------------

# Empty = access disabled. Use a separate random secret (at least 32 random bytes),
# not B2 credentials or a user password. Send it only to Validator over HTTPS
# in X-API-Key. The integration endpoint always returns a proxied PNG stream.
INTEGRATION_IMAGE_API_KEY=

# -----------------------------------------------------------------------------
# Backblaze B2 cloud storage (S3-compatible API)
# -----------------------------------------------------------------------------

# Keep disabled until the bucket, application key and lifecycle rule are ready.
B2_ENABLED=false

# S3 endpoint from the Backblaze bucket page, without the bucket name.
# Example: https://s3.eu-central-003.backblazeb2.com
# The application derives the B2 region from this endpoint.
B2_ENDPOINT=

B2_BUCKET=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=

# Must match the lifecycle rule and the application-key file-name prefix.
B2_OBJECT_PREFIX=validator/

# Upload only this many database candidates per scheduler run. Image bytes are
# streamed and are never loaded into memory as one batch.
B2_UPLOAD_BATCH_SIZE=1000
B2_UPLOAD_CONCURRENCY=8
B2_UPLOAD_DELAY=10s
B2_UPLOAD_RETRY_DELAY=5m

# Prefer the local file before this age, then redirect to a B2 pre-signed URL.
B2_LOCAL_PREFERRED_AGE=3d

# Spring duration examples: 15m, 30m, 1h. Keep this reasonably short because
# anyone holding an unexpired URL can download the private object.
B2_PRESIGNED_URL_TTL=30m

# This must remain 21d to match the fixed B2 lifecycle rule documented in
# README.md and RUNBOOK.md; application validation rejects any other value.
B2_METADATA_RETENTION=21d

# AWS SDK network/request safety. The SDK retries retryable failures with
# exponential backoff; the scheduler keeps its existing retry-after-failure.
B2_CONNECT_TIMEOUT=5s
B2_SOCKET_TIMEOUT=30s
B2_API_CALL_ATTEMPT_TIMEOUT=45s
B2_API_CALL_TIMEOUT=2m
B2_MAX_ATTEMPTS=4

# -----------------------------------------------------------------------------
# Slack rejected-screenshot notifications
# -----------------------------------------------------------------------------

# Disabled by default. Uses a Slack Bot Web API token when enabled.
SLACK_REJECTED_NOTIFICATIONS_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_REJECTED_DETAILS_LIMIT=10
# Public URL of the protected admin export section shown in Slack messages.
# Example: https://validator.example.com/admin#rejected-export-title
SLACK_REJECTED_ARCHIVE_URL=
SLACK_CONNECT_TIMEOUT=2s
SLACK_READ_TIMEOUT=3s

# -----------------------------------------------------------------------------
# Persistent PostgreSQL storage and credentials
# -----------------------------------------------------------------------------

# Host directory containing persistent PostgreSQL files.
# Keep it on a local disk outside OneDrive and other synchronized folders.
# Linux example: /opt/dataox/validator-api-build/postgres-data
# Windows example: C:/recognition-validator-data/postgres
POSTGRES_DATA_ROOT_HOST=./data/postgres

DB_NAME=recognition_validator
DB_USERNAME=validator

# Replace before the first start. Changing it later does not update an existing DB.
DB_PASSWORD=change-me-before-start

# -----------------------------------------------------------------------------
# Application database pool
# -----------------------------------------------------------------------------

# Safe defaults for the expected small number of concurrent operators.
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# -----------------------------------------------------------------------------
# PostgreSQL process
# -----------------------------------------------------------------------------

POSTGRES_MAX_CONNECTIONS=50

# Shared memory available to PostgreSQL inside the container.
POSTGRES_SHM_SIZE=256mb

# Operators already parallelize the workload; avoid extra workers per query.
POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=0

# -----------------------------------------------------------------------------
# Image indexing
# -----------------------------------------------------------------------------

# Maximum number of image metadata rows written in one database batch.
VALIDATOR_BATCH_SIZE=1000

# -----------------------------------------------------------------------------
# Review queue
# -----------------------------------------------------------------------------

# How long a claimed screenshot remains assigned when the operator disappears.
# Spring duration examples: 30m, 2h, 45s.
VALIDATOR_LEASE_DURATION=30m

# -----------------------------------------------------------------------------
# Database retention cleanup
# -----------------------------------------------------------------------------

# Retain image metadata and review tasks for four UTC calendar days.
VALIDATOR_RETENTION=4d

# Run database cleanup every day at 09:00 UTC.
VALIDATOR_CLEANUP_CRON=0 0 9 * * *

# Maximum rows deleted per cleanup transaction.
VALIDATOR_CLEANUP_BATCH_SIZE=5000

# Set to 0 to keep deleting batches until no expired rows remain.
# A positive value limits the number of batches per cleanup run.
VALIDATOR_CLEANUP_MAX_BATCHES=0

# -----------------------------------------------------------------------------
# Filesystem watcher
# -----------------------------------------------------------------------------

# Disable only for diagnostics; without it new files require reconciliation/restart.
VALIDATOR_WATCH_ENABLED=true

# Coalesce filesystem events and write them to the database at this interval.
VALIDATOR_WATCH_FLUSH_INTERVAL=2s

# Application-side event buffer. Overflow triggers a full reconciliation scan.
VALIDATOR_WATCH_MAX_PENDING_EVENTS=50000
