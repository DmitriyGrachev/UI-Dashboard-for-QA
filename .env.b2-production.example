# Add/replace these keys in the EXISTING server .env; do not replace the whole file.
# Keep DB credentials, POSTGRES_DATA_ROOT_HOST, VALIDATOR_IMAGE_ROOT_HOST, ports
# and Slack settings unchanged. Never use the benchmark environment file here.

# First deploy/check schema and operator UI with false. Then enable true after
# confirming the client's production bucket, credentials, capacity and lifecycle.
B2_ENABLED=false
B2_ENDPOINT=
B2_BUCKET=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_OBJECT_PREFIX=validator/

# One shared metadata batch, eight workers (one file per worker at a time).
B2_UPLOAD_CONCURRENCY=8
B2_UPLOAD_BATCH_SIZE=1000
B2_UPLOAD_DELAY=10s
B2_UPLOAD_RETRY_DELAY=5m
B2_LOCAL_PREFERRED_AGE=3d
B2_PRESIGNED_URL_TTL=30m
B2_METADATA_RETENTION=21d
B2_CONNECT_TIMEOUT=5s
B2_SOCKET_TIMEOUT=30s
B2_API_CALL_ATTEMPT_TIMEOUT=45s
B2_API_CALL_TIMEOUT=2m
B2_MAX_ATTEMPTS=4

APP_MEMORY_LIMIT=5g
# Optional whole-app quota (UI + indexing + B2). Set 2.0 only after approval.
# Leaving 0.0 preserves the current lack of a CPU quota. Docker build is separate.
APP_CPU_LIMIT=0.0
